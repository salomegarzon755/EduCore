# Copia este archivo como backend/.env y completa los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# --- NUBE (Neon) ---------------------------------------------------------
# Si defines DATABASE_URL se usa esta y se ignoran las variables de local.
# Usa la cadena "pooled" (host con -pooler) que muestra el boton Connect de Neon.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA

# --- LOCAL ---------------------------------------------------------------
DB_NAME= educore_db
DB_USER= postgres
DB_PASSWORD= 1234
DB_HOST= localhost
DB_PORT= 5432

# --- CORS ----------------------------------------------------------------
# En produccion: URL de tu sitio estatico en Render, SIN barra final.
# Varias URLs separadas por coma. Con * se permite cualquier origen (solo para pruebas).
FRONTEND_ORIGIN= http://localhost:5500

# Obligatorio: clave aleatoria compartida entre instancias de Render, 32+ caracteres
AUTH_SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
